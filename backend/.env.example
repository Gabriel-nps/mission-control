# Copie para .env e ajuste conforme o ambiente.
# O .env nao e versionado.

# Segredo usado para assinar os JWTs (HS256).
# Obrigatorio fora do desenvolvimento local. Gere um valor forte, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-insecure-secret

# Endereco do broker Kafka, usado pela API e pelo worker.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
